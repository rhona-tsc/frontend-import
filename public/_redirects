[build]
  publish = "dist"

# ✅ JS/CSS build assets can be cached long-term
[[headers]]
  for = "/assets/*.js"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/assets/*.css"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

# ✅ Fonts can be cached long-term
[[headers]]
  for = "/assets/*.woff2"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

# ✅ Images can be cached long-term (adjust if you prefer)
[[headers]]
  for = "/assets/*.png"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/assets/*.jpg"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/assets/*.jpeg"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/assets/*.webp"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/assets/*.svg"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"
    Netlify-CDN-Cache-Control = "public, max-age=31536000, immutable"

# 🚫 IMPORTANT: prevent caching of 404 HTML responses under /assets/*
# This ensures a missing asset doesn't get cached for a year.
[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "no-store, max-age=0"
    Netlify-CDN-Cache-Control = "no-store"
# ✅ Old URLs → new URLs (must be ABOVE the SPA catch-all)
/bandsforhire        /act            301!
/bandsforhire/*      /act/:splat     301!

# ✅ API proxy
/api/*  https://tsc-backend-v2.onrender.com/api/:splat  200

# 🚫 IMPORTANT: ensure /assets/* never falls through to SPA index.html
# This preserves normal asset serving, but missing assets will 404 (instead of returning index.html).
/assets/*  /assets/:splat  200

# ✅ SPA fallback (keep LAST)
/*      /index.html  200