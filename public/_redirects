# ✅ Old URLs → new URLs (must be ABOVE the SPA catch-all)
 /bandsforhire        /act            301!
 /bandsforhire/*      /act/:splat     301!

# ✅ API proxy
/api/*  https://tsc-backend-v2.onrender.com/api/:splat  200

# ✅ Assets must NOT hit the SPA fallback.
# Rewriting to itself means:
#  - existing files in /assets/* are served normally
#  - missing files correctly return 404 (instead of /index.html)
/assets/*  /assets/:splat  200

# ✅ SPA fallback (keep LAST)
 /*      /index.html  200